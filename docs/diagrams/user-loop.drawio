2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="Per-call files are concatenated into one transcript and timing.json; every exchange is in user_loop.json. Stand-in cost is reported but never added to an arm." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="270" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>