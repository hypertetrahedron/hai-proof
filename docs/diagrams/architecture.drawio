ivate/ for your own" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="270" height="55" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;pairs, shuffling, retries, resource gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="270" height="60" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;results/&amp;lt;run-id&amp;gt;/&lt;/b&gt;&lt;br&gt;run.json · trials.jsonl · trials/&lt;br&gt;summary.json · report.html" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="270" height="70" as="geometry"/></mxCell><mxCell id="exe" value="&lt;b&gt;Executor&lt;/b&gt;&lt;br&gt;LocalExecutor: docker …&lt;br&gt;SshExecutor: ssh &amp;lt;alias&amp;gt; docker …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="270" height="75" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;base image&lt;/b&gt;&lt;br&gt;Python 3.12, Node 22, uv, git&lt;br&gt;claude-code @ pinned version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="200" height="75" as="geometry"/></mxCell><mxCell id="arm" value="&lt;b&gt;arm image&lt;/b&gt;&lt;br&gt;plain = base;&lt;br&gt;treatment = base + its tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="200" height="75" as="geometry"/></mxCell><mxCell id="trial" value="&lt;b&gt;trial image&lt;/b&gt;&lt;br&gt;one per (arm, task):&lt;br&gt;+ repo/ + task install" style="rounded=1;whi