+            depth = 0
+            for i, value_pattern in enumerate(pattern.values):
+                self.writeline(f"if {ok}:")
+                self.indent()
+                depth += 1
+                value = self.temporary_identifier()
+                self.writeline(f"{value} = {subject}[{keys}[{i}]]")
+                self.match_pattern(value_pattern, value, ok, frame)
+            if pattern.rest is not None:
+                self.writeline(f"if {ok}:")
