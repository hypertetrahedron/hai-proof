<mxfile host="hai-proof"><diagram id="user-loop" name="user-loop"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="User in the loop: the turn loop and the ask tool" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Agent call NN&lt;/b&gt;&lt;br&gt;claude -p --session-id / --resume&lt;br&gt;with what is left of the limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="70" as="geometry"/></mxCell><mxCell id="q0" value="ended abnormally?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="180" height="90" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Stop&lt;/b&gt;&lt;br&gt;abnormal end (error · turns · budget · time ·&lt;br&gt;rate or usage limit) or the script is done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="260" height="60" as="geometry"/></mxCell><mxCell id="q1" value="conventional mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="275" width="180" height="90" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Stand-in: classify&lt;/b&gt;&lt;br&gt;WAITING or DONE&lt;br&gt;(never sees the brief)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="285" width="220" height="70" as="geometry"/></mxCell><mxCell id="q2" value="WAITING and replies left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="390" width="200" height="100" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Stand-in reply&lt;/b&gt;&lt;br&gt;uninformative: fixed text&lt;br&gt;informative / reticent: from user.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="395" width="240" height="90" as="geometry"/></mxCell><mxCell id="nx" value="&lt;b&gt;Next scripted turn?&lt;/b&gt;&lt;br&gt;[workflow] turns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="180" height="60" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="q0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q0" target="s0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="205"/><mxPoint x="25" y="630"/></Array></mxGeometry></mxCell><mxCell id="edge3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;o