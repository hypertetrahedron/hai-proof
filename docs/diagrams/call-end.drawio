<mxfile host="hai-proof"><diagram id="call-end" name="call-end"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="When does an agent call end?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;claude -p streams events&lt;/b&gt;&lt;br&gt;the wrapper copies them to transcript.jsonl&lt;br&gt;and tracks background tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="r" value="result event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="160" width="160" height="40" as="geometry"/></mxCell><mxCell id="q1" value="background subagent running?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="225" width="210" height="110" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Keep the call open&lt;/b&gt;&lt;br&gt;the CLI wakes the agent when the&lt;br&gt;subagent finishes → another result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="235" width="260" height="90" as="geometry"/></mxCell><mxCell id="q2" value="only background shells running?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="370" width="210" height="110" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Wait up to 10 min&lt;/b&gt;&lt;br&gt;(SHELL_WAIT_S) for another result;&lt;br&gt;then stop: shell_wait_cut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="260" height="90" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;End the call&lt;/b&gt;&lt;br&gt;close stdin, 10 s grace, then stop:&lt;br&gt;later output is drained, not recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="300" height="70" as="geometry"/></mxCell><mxCell id="tl" value="&lt;b&gt;Time limit&lt;/b&gt;&lt;br&gt;bounds every wait; the CLI&#x27;s own&lt;br&gt;10-min print-mode ceiling is off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="515" width="260" height="70" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="next result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="w1" target="r"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="180"/></Array></mxGeometry></mxCell><mxCell id="edge5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="w2" target="r"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="425"/><mxPoint x="690" y="170"/></Array></mxGeometry></mxCell><mxCell id="edge8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="10 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="w2" target="e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="495"/><mxPoint x="370" y="495"/><mxPoint x="370" y="550"/></Array></mxGeometry></mxCell><mxCell id="n" value="Applies in both input modes (plain print mode and the ask-tool stdio mode). timing.json records results, bg_agent_waits, bg_wait_s and shell_wait_cut. Tasks a subagent owns are ignored." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>