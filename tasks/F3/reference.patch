new file mode 100644
index 00000000..43145f27
--- /dev/null
+++ b/rich/linelimit.py
@@ -0,0 +1,86 @@
+from typing import TYPE_CHECKING, Optional
+
+from .cells import cell_len, set_cell_size
+from .jupyter import JupyterMixin
+from .measure import Measurement
+from .segment import Segment
+
+if TYPE_CHECKING:
+    from .console import Console, ConsoleOptions, RenderableType, RenderResult
+
+
+def validate_max_lines(max_lines: Optional[int]) -> None:
+    """Check a ``max_lines`` value is ``None`` or an integer >= 1.
+
+    Raises:
+        ValueError: If the value is not valid.
+    """
+    if max_lines is not None and (
+        isinstance(max_lines, bool) or not isinstance(max_lines, int) or max_lines < 1
+    ):
+        raise ValueError(
+            f"max_lines must be None or an integer >= 1 (not {max_lines!r})"
+        )
+
+
+class LineLimit(JupyterMixin):
+    """Renders a renderable, truncating it to a maximum number of lines.
+
+    If lines are removed, the last remaining line has its trailing whitespace stripped,
+    is cropped (if required) to leave room for the marker, and the marker is appended.
+    The text ``{hidden}`` in the marker is replaced with the number of lines removed.
+
+    Args:
+        renderable (RenderableType): A console renderable.
+        max_lines (int, optional): Maximum number of lines, or ``None`` for no limit.
+        more_marker (str, optional): Marker to show when lines have been removed. Defaults to "\u2026".
+    """
+
+    def __init__(
+        self,
+        renderable: "RenderableType",
+        max_lines: Optional[int],
+        more_marker: str = "\u2026",
+    ) -> None:
+        validate_max_lines(max_lines)
+        self.renderable = renderable
+        self.max_lines = max_lines
+        self.more_marker = more_marker
+        # Table cells use this to pick their vertical alignment.
+        self.vertical = getattr(renderable, "vertical", None)
+
+    def __rich_measure__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> Measurement:
+        return Measurement.get(console, options, self.renderable)
+
+    def __rich_console__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> "RenderResult":
+        width = options.max_width
+        lines = console.render_lines(
+            self.renderable, options.update(height=None), pad=False
+        )
+        new_line = Segment.line()
+        max_lines = self.max_lines
+        if max_lines is not None and len(lines) > max_lines:
+            hidden = len(lines) - max_lines
+            lines = lines[:max_lines]
+            last = list(lines[-1])
+            while last and (last[-1].is_control or not last[-1].text.rstrip()):
+                last.pop()
+            if last:
+                last[-1] = Segment(last[-1].text.rstrip(), last[-1].style)
+            marker = self.more_marker.replace("{hidden}", str(hidden))
+            if cell_len(marker) > width:
+                marker = set_cell_size(marker, width)
+            limit = width - cell_len(marker)
+            if Segment.get_line_length(last) > limit:
+                last = Segment.adjust_line_length(last, limit)
+            if marker:
+                style = last[-1].style if last else None
+                last.append(Segment(marker, style))
+            lines[-1] = last
+        for line in lines:
+            yield from line
+            yield new_line
