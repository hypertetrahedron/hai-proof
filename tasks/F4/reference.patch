+def _is_irrefutable(pattern: nodes.Pattern) -> bool:
+    """A pattern that matches every subject."""
+    if isinstance(pattern, (nodes.WildcardPattern, nodes.CapturePattern)):
+        return True
+    if isinstance(pattern, nodes.AsPattern):
+        return _is_irrefutable(pattern.pattern)
+    if isinstance(pattern, nodes.OrPattern):
+        return any(_is_irrefutable(p) for p in pattern.patterns)
+    return False
+
+
+def _bound_names(pattern: nodes.Pattern) -> t.List[str]:
+    """The names a pattern binds, in order, with repeats."""
+    if isinstance(pattern, nodes.CapturePattern):
+        return [pattern.target.name]
+    if isinstance(pattern, nodes.StarPattern):
+        return [pattern.target.name] if pattern.target is not None else []
+    if isinstance(pattern, nodes.AsPattern):
+        return _bound_names(pattern.pattern) + [pattern.target.name]
+    if isinstance(pattern, nodes.OrPattern):
+        # all alternatives bind the same names, checked by the parser
+        return _bound_names(pattern.patterns[0])
+    if isinstance(pattern, nodes.SequencePattern):
+        return [n for p in pattern.items for n in _bound_names(p)]
+    if isinstance(pattern, nodes.MappingPattern):
+        rv = [n for p in pattern.values for n in _bound_names(p)]
+        if pattern.rest is not None:
+            rv.append(pattern.rest.name)
+        return rv
+    return []
+
