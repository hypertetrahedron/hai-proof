<mxfile host="hai-proof"><diagram id="trial-lifecycle" name="trial-lifecycle"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="One trial: one arm, one task, one repetition" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="g0" value="Set up (untimed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fbf2;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="255" height="430" as="geometry"/></mxCell><mxCell id="c0_0" value="&lt;b&gt;1 · Start container&lt;/b&gt;&lt;br&gt;trial image, 4 CPU / 8 GB,&lt;br&gt;arm network, secrets on stdin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="95" width="225" height="75" as="geometry"/></mxCell><mxCell id="c0_1" value="&lt;b&gt;2 · Apply treatment&lt;/b&gt;&lt;br&gt;user/ → ~/.claude, project/ → /work,&lt;br&gt;[setup] commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="190" width="225" height="75" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c0_0" target="c0_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c0_2" value="&lt;b&gt;3 · Mark start state&lt;/b&gt;&lt;br&gt;git commit, refs/hai-proof/baseline" style="rounded=1;w