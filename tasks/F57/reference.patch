     )
 
 
+def wants_extra_args(f: Callable[..., Any]) -> bool:
+    """Check if the function wants an additional argument beside
+    its first positional one.
+    """
+    return (
+        sum(
+            p.kind != inspect.Parameter.KEYWORD_ONLY for p in get_function_parameters(f)
+        )
+        > 1
+    )
+
+
