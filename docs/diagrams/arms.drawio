<mxfile host="hai-proof"><diagram id="arms" name="arms"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="What differs between the arms" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="sh" value="Held equal in every pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fbf2;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="860" height="110" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Model and effort&lt;/b&gt;&lt;br&gt;subagents pinned to the same model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="195" height="60" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Claude Code version&lt;/b&gt;&lt;br&gt;resolved once, baked into base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="95" width="195" height="60" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Task and its limits&lt;/b&gt;&lt;br&gt;time, turns, budget × limit-scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="95" width="195" height="60" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Host, CPU, memory&lt;/b&gt;&lt;br&gt;both start together, 50 ms apart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="95" width="195" height="60" as="geometry"/></mxCell><mxCell id="ca" value="Arm A: plain Claude Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="420" height="380" as="geometry"/></mxCell><mxCell id="cb" value="Arm B: plain + one treatment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbef;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="420" height="380" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;base image&lt;/b&gt;&lt;br&gt;same digest in both arms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="380" height="50" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;base image&lt;/b&gt;&lt;br&gt;same digest in both arms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="380" height="50" as="geometry"/></mxCell><mxCell id="a2" value="(no extra layer)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="380" height="45" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;treatment layer&lt;/b&gt;&lt;br&gt;[[requires]] installs and checks · Dockerfile fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="295" width="380" height="50" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;task layer&lt;/b&gt;&lt;br&gt;repo/ at the pinned base SHA · task install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="380" height="50" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;task layer&lt;/b&gt;&lt;br&gt;repo/ at the pinned base SHA · task install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="380" height="50" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;at trial start&lt;/b&gt;&lt;br&gt;empty ~/.claude · nothing added to /work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="380" height="60" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;at trial start&lt;/b&gt;&lt;br&gt;user/ → ~/.claude · project/ → /work&lt;br&gt;[setup] commands (untimed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="425" width="380" height="60" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;agent call&lt;/b&gt;&lt;br&gt;the task prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="380" height="55" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;agent call&lt;/b&gt;&lt;br&gt;prompt_prefix / prompt_variant · [workflow] turns · [env]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="380" height="55" as="geometry"/></mxCell><mxCell id="n" value="Orange marks the only places the arms can differ. The run checks it: each arm&#x27;s init event must show what its manifest declares ([expect]) and plain must load no plugin or MCP server; an arm&#x27;s image must not contain another arm&#x27;s tools." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="860" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>