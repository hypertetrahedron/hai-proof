diff --git a/src/marshmallow/validate.py b/src/marshmallow/validate.py
index 35c0e8bc..054a062c 100644
--- a/src/marshmallow/validate.py
+++ b/src/marshmallow/validate.py
@@ -706,3 +706,33 @@ class ContainsNoneOf(NoneOf):
             if val in self.iterable:
                 raise ValidationError(self._format_error(value))
         return value
+
+
+class Unique(Validator):
+    """Validator which succeeds if no two elements of ``value`` are equal.
+    Empty input is considered valid. Elements do not need to be hashable.
+
+    :param error: Error message to raise in case of a validation error.
+
+    .. versionadded:: 4.4.0
+    """
+
+    default_message = "Items must be unique."
+
+    def __init__(self, *, error: str | None = None):
+        self.error: str = error or self.default_message
+
+    def __call__(self, value: typing.Iterable[_T]) -> typing.Iterable[_T]:
+        seen_hashable: set[typing.Any] = set()
+        seen_unhashable: list[typing.Any] = []
+        for item in value:
+            try:
+                if item in seen_hashable:
+                    raise ValidationError(self.error)
+                seen_hashable.add(item)
+            except TypeError:
+                # Unhashable item (e.g. a dict or list), fall back to equality
+                if item in seen_unhashable:
+                    raise ValidationError(self.error) from None
+                seen_unhashable.append(item)
+        return value
