><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.1;entryY=0.5;" edge="1" parent="1" source="pa" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0.4;entryY=0.95;" edge="1" parent="1" source="pb" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="453"/></Array></mxGeometry></mxCell><mxCell id="edge7" value="via the&lt;br&gt;arm&#x27;s proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.85;" edge="1" parent="1" source="si" target="pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="docker run: both arms start together" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="trial" target="ta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="190"/><mxPoint x="525" y="190"/></Array></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.86;" edge="1" parent="1" source="exe" target="host"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="The Executor sends docker commands and tar streams; credentials go only on stdin, never on a command line or into an image. No bind mounts: every file moves as a tar stream, so the same steps work locally and over SSH. Timing is taken inside the container, so SSH latency never reaches a measurement. Hidden tests are in no image: they are copied in after the agent exits, with the network cut." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="700" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>