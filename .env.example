# Copy to .env (gitignored) and fill in ONE of these. hai-proof reads it at run time;
# a variable already set in the environment takes precedence.

# API key from the Anthropic Console (starts with sk-ant-api...). Preferred: enables the
# free credential check before any trial runs.
ANTHROPIC_API_KEY=

# Or a subscription token from `claude setup-token` (starts with sk-ant-oat...).
CLAUDE_CODE_OAUTH_TOKEN=
