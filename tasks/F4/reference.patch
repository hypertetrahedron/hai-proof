+class Match(Stmt):
+    """A ``{% match %}`` statement.  ``subject`` is evaluated once and
+    compared against the patterns of the cases in order.
+
+    .. versionadded:: 3.2
+    """
+
+    fields = ("subject", "cases")
+    subject: "Expr"
+    cases: t.List["MatchCase"]
+
+
+class MatchCase(Helper):
+    """One ``{% case pattern if guard %}`` of a :class:`Match`."""
+
+    fields = ("pattern", "guard", "body")
+    pattern: "Pattern"
+    guard: t.Optional["Expr"]
+    body: t.List[Node]
+
+
+class Pattern(Helper):
+    """Baseclass for the patterns of a :class:`MatchCase`."""
+
+    abstract = True
+
+
+class WildcardPattern(Pattern):
+    """``_``, matches anything and binds nothing."""
+
+    fields = ()
+
+
+class CapturePattern(Pattern):
+    """A bare name, matches anything and binds it to ``target``."""
+
+    fields = ("target",)
+    target: "Name"
+
+
+class ValuePattern(Pattern):
+    """Matches if the subject equals ``value`` (a literal or a dotted
+    name).  ``none``, ``true`` and ``false`` are compared by identity.
+    """
+
+    fields = ("value",)
+    value: "Expr"
+
+
+class SequencePattern(Pattern):
+    """``[p, ...]`` or ``(p, ...)``, at most one item may be a
+    :class:`StarPattern`.
+    """
+
+    fields = ("items",)
+    items: t.List["Pattern"]
+
+
+class StarPattern(Pattern):
+    """``*name`` inside a sequence pattern.  ``target`` is ``None`` for
+    ``*_``.
+    """
+
+    fields = ("target",)
+    target: t.Optional["Name"]
+
+
+class MappingPattern(Pattern):
+    """``{key: p, ..., **rest}``."""
+
+    fields = ("keys", "values", "rest")
+    keys: t.List["Expr"]
+    values: t.List["Pattern"]
+    rest: t.Optional["Name"]
+
+
+class OrPattern(Pattern):
+    """``p | p | ...``, the first alternative that matches wins."""
+
+    fields = ("patterns",)
+    patterns: t.List["Pattern"]
+
+
+class AsPattern(Pattern):
+    """``p as name``."""
+
+    fields = ("pattern", "target")
+    pattern: "Pattern"
+    target: "Name"
+
+
+class TestPattern(Pattern):
+    """``is [not] test(args)``.  ``test.node`` is an internal name the
+    compiler assigns the value being matched to.
+    """
+
+    fields = ("test", "negated")
+    test: "Test"
+    negated: bool
+
+
 class Block(Stmt):
     """A node that represents a block.
 
