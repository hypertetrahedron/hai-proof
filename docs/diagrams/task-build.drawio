<mxfile host="hai-proof"><diagram id="task-build" name="task-build"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="From an upstream commit to a calibrated task" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="src" value="tasks/&amp;lt;ID&amp;gt;/ (authored, committed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fbf2;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="300" height="420" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;task.toml&lt;/b&gt;&lt;br&gt;[source] url · base SHA · fix SHA&lt;br&gt;kind · level · limits · suites · install" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="270" height="62" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;prompt.md&lt;/b&gt;&lt;br&gt;what a developer would type;&lt;br&gt;never mentions hidden tests" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="35" y="165" width="270" height="62" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;inject.patch / reference.patch&lt;/b&gt;&lt;br&gt;injected bug, or the fix&#x27;s non-test part" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="35" y="240" width="270" height="62" as="geometry"/></mxCell><mxCell id="f3" value=