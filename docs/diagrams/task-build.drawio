eometry"/></mxCell><mxCell id="lv" value="&lt;b&gt;Set level and limits&lt;/b&gt;&lt;br&gt;from median wall time and turns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="200" width="230" height="60" as="geometry"/></mxCell><mxCell id="sx" value="&lt;b&gt;Tag suites, tier, report_order&lt;/b&gt;&lt;br&gt;cost tier from median output tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="290" width="230" height="60" as="geometry"/></mxCell><mxCell id="bl" value="&lt;b&gt;baseline.json&lt;/b&gt;&lt;br&gt;plain-arm samples per model /&lt;br&gt;CLI / effort / limit-scale / hash" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="670" y="380" width="230" height="75" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f0" target="bt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bt" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gen" target="vt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vt" target="pl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="352"/><mxPoint x="640" y="130"/></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pl" target="lv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lv" target="sx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="every real run adds samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sx" target="bl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="Everything is pinned by SHA, and test dependencies by version, so anyone can rebuild a task byte for byte. A changed task gets a new content hash and its own baselines." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="520" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>