+        separated list of patterns is a sequence pattern.
+        """
+        lineno = self.stream.current.lineno
+        pattern = self._parse_sequence_item()
+        if self.stream.current.type == "comma":
+            items = [pattern]
+            while self.stream.skip_if("comma"):
+                if self.stream.current.type == "block_end" or self.stream.current.test(
+                    "name:if"
+                ):
+                    break
+                items.append(self._parse_sequence_item())
+            pattern = self._make_sequence(items, lineno)
+        elif isinstance(pattern, nodes.StarPattern):
+            self.fail("star pattern outside of a sequence pattern", lineno)
+        self._check_bindings(pattern, lineno)
+        return pattern
+
+    def _parse_sequence_item(self) -> nodes.Pattern:
+        if self.stream.current.type == "mul":
+            lineno = next(self.stream).lineno
+            name = self.stream.expect("name")
+            target = None
+            if name.value != "_":
