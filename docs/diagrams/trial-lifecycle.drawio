nce ∧ regression&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="845" y="500" width="255" height="40" as="geometry"/></mxCell><mxCell id="n" value="Any exception becomes a recorded trial with status error. excluded (isolation or leakage) and discarded (transient, or a failed partner) trials stay in trials.jsonl but are not scored." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="800" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>