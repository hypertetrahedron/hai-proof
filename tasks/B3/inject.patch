@@ -27,6 +32,18 @@ def ratio_resolve(total: int, edges: Sequence[Edge]) -> List[int]:
     Returns:
         List[int]: Number of characters for each edge.
     """
+    key = (total, tuple(edges))
+    cached = _RESOLVE_CACHE.get(key)
+    if cached is not None:
+        return cached[:]
+    sizes = _ratio_resolve(total, edges)
+    if len(_RESOLVE_CACHE) >= _RESOLVE_CACHE_SIZE:
+        _RESOLVE_CACHE.clear()
+    _RESOLVE_CACHE[key] = sizes[:]
+    return sizes
+
+
+def _ratio_resolve(total: int, edges: Sequence[Edge]) -> List[int]:
     # Size of edge or None for yet to be determined
     sizes = [(edge.size or None) for edge in edges]
 
