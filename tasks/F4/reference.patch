+    def parse_match(self) -> nodes.Match:
+        """Parse a match statement."""
+        lineno = self.stream.expect("name:match").lineno
+        subject = self.parse_tuple()
+        end_tokens = ("name:case", "name:endmatch")
+        leading = self.parse_statements(end_tokens)
+        for node in leading:
+            if not (
+                isinstance(node, nodes.Output)
+                and all(
+                    isinstance(child, nodes.TemplateData) and not child.data.strip()
+                    for child in node.nodes
+                )
+            ):
+                self.fail(
+                    "only whitespace and comments may appear between 'match'"
+                    " and the first 'case'",
+                    node.lineno,
+                )
+        cases: t.List[nodes.MatchCase] = []
+        while next(self.stream).value == "case":
+            case_lineno = self.stream.current.lineno
+            pattern = self.parse_pattern()
+            guard = None
+            if self.stream.skip_if("name:if"):
+                guard = self.parse_expression()
+            body = self.parse_statements(end_tokens)
+            cases.append(
+                nodes.MatchCase(pattern, guard, body, lineno=case_lineno)
+            )
+        if not cases:
+            self.fail("a 'match' block needs at least one 'case'", lineno)
+        for case in cases[:-1]:
+            if case.guard is None and _is_irrefutable(case.pattern):
+                self.fail(
+                    "irrefutable pattern makes the remaining cases unreachable",
+                    case.lineno,
+                )
+        return nodes.Match(subject, cases, lineno=lineno)
+
