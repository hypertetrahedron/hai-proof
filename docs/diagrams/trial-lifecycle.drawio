eometry"><Array as="points"><mxPoint x="285" y="357"/><mxPoint x="285" y="132"/></Array></mxGeometry></mxCell><mxCell id="g2" value="Collect and check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="570" y="55" width="255" height="430" as="geometry"/></mxCell><mxCell id="c2_0" value="&lt;b&gt;6 · Collect&lt;/b&gt;&lt;br&gt;/out/agent, claude_home/&lt;br&gt;(secrets scrubbed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="585" y="95" width="225" height="75" as="geometry"/></mxCell><mxCell id="c2_1" value="&lt;b&gt;7 · Read transcript&lt;/b&gt;&lt;br&gt;turns, tokens, cost, wall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="585" y="190" width="225" height="75" as="geometry"/></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2_0" target="c2_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2_2" value="&lt;b&gt;Checks&lt;/b&gt;&lt;br&gt;isolation · leakage ·&lt;br&gt;rate / usage / auth · tool use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="585" y="285" width="225" height="75" as="geometry"/></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2_1" target="c2_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2_3" value="&lt;b&gt;8 · Diff&lt;/b&gt;&lt;br&gt;session.patch vs baseline ref,&lt;br&gt;diff_breakdown.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="585" y="380" width="225" height="75" as="geometry"/></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2_2" target="c2_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1_3" target="c2_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="357"/><mxPoint x="560" y="132"/></Array></mxGeometry></mxCell><mxCell id="g3" value="Grade offline, record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5fc;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="845" y="55" width="255" height="430" as="geometry"/></mxCell><mxCell id="c3_0" value="&lt;b&gt;9 · Cut network&lt;/b&gt;&lt;br&gt;kill claude, copy hidden_tests/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="95" width="225" height="75" as="geometry"/></mxCell><mxCell id="c3_1" value="&lt;b&gt;Acceptance&lt;/b&gt;&lt;br&gt;hidden tests (pytest ids&lt;br&gt;or acceptance_cmd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="225" height="75" as="geometry"/></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;