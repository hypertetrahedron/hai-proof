ckgroundColor=#ffffff;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7" value="&lt;b&gt;Context-tax probe&lt;/b&gt;&lt;br&gt;“Reply with OK” × 5 per arm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="498" width="280" height="52" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="Scored pairs: for each rep, tasks shuffled by seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="390" y="55" width="520" height="520" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Next (task, rep) group&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="200" height="50" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Spend guard&lt;/b&gt;&lt;br&gt;spent + dearest pair ≤ --max-spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="200" height="60" as="geometry"/></mxCell><mxCell id="q3" value="&lt;b&gt;Resource gate&lt;/b&gt;&lt;br&gt;memory, leaked containers&lt;br&gt;→ resources.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="240" width="200" height="70" as="geometry"/></mxCell><mxCell id="q4" value="&lt;b&gt;Trial A ∥ Trial B&lt;/b&gt;&lt;br&gt;same tas